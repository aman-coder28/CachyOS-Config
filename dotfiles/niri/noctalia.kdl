layout {
  focus-ring {
    active-color   "#8fcdff"
    inactive-color "#131313"
    urgent-color   "#ffb4ab"
  }

  border {
    active-color   "#8fcdff"
    inactive-color "#131313"
    urgent-color   "#ffb4ab"
  }


  tab-indicator {
    active-color   "#8fcdff"
    inactive-color "#004b71"
    urgent-color   "#ffb4ab"
  }

  insert-hint {
    color "#8fcdff80"
  }
}

recent-windows {
  highlight {
    active-color "#8fcdff"
    urgent-color "#ffb4ab"
  }
}
