layout {

    focus-ring {
        active-color   "#e9c348"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e9c348"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#e9c348"
        inactive-color "#574500"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e9c34880"
    }
}

recent-windows {
    highlight {
        active-color "#e9c348"
        urgent-color "#ffb4ab"
    }
}
